# ============================================================================
# KIID FROM DREAM POS - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Multi-Tenant Cloud Database (PostgreSQL 16+)
# Leave commented or empty to run in local edge mode (SQLite)
DATABASE_URL=postgresql://postgres:your_secure_password@your-pg-host.cloud.com:5432/kiid_pos_saas?sslmode=require
PG_POOL_MAX=20

# Cloud Object Storage (Cloudflare R2 / AWS S3)
# Used for storing tenant logos, receipts, and product image uploads
S3_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
S3_BUCKET_NAME=kiid-pos-media
S3_REGION=auto
S3_PUBLIC_DOMAIN=https://media.kiidfromdream.com

# Frontend Cloud API Endpoint (Web Dashboard & Remote Terminals)
# Leave empty for same-origin local hosting, or set to your public cloud API domain
VITE_API_BASE_URL=https://api.kiidfromdream.com
